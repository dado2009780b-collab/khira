# Local Node.js: Session pooler usually uses port 5432.
# Cloudflare Workers: use Supabase Transaction pooler, usually port 6543.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Existing administrator session configuration
SESSION_SECRET=
ADMIN_PASSWORD=

# Optional Telegram order notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required by the API server
PORT=5000
NODE_ENV=development
