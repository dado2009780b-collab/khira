# PostgreSQL connection string (Project Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Existing administrator session configuration
SESSION_SECRET=
ADMIN_PASSWORD=

# Optional Telegram order notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required by the API server
PORT=5000
NODE_ENV=development
